# Copy to .env (never commit .env). Placeholders only — no real secrets here.
# Use "demo" for the local sample catalog; production must use "database".
CATALOG_SOURCE="demo"
# Optional integration tests: use a dedicated local database whose name contains "test".
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/devx_store_test"
# Runtime: pooled Supavisor connection (port 6543) via the least-privilege devx_store_app role.
DATABASE_URL="postgresql://devx_store_app.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# Migrations only: session-mode connection (port 5432) with a role that has DDL rights.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/devx_store_shadow?schema=public"
# >= 32 random bytes, e.g. `openssl rand -base64 48`
SESSION_SECRET="change-me"   # REQUIRED: auth fails closed unless this is >= 32 random chars
APP_BASE_URL="http://localhost:3000"
# Admin bootstrap (Stage 2 auth): initial admin created by seed from these
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""
# Social login (optional; leave empty to keep disabled)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
# Payment receiving details shown to customers are managed in StoreSetting (admin), not env.
# Payment gateway adapters (future): keys go here, never in code
FAWRY_MERCHANT_CODE=""
FAWRY_SECURITY_KEY=""
